# =========================================================
# NEWMAN TOUR BALI — GITIGNORE
# Project source only. Never commit secrets or private data.
# =========================================================


# ---------------------------------------------------------
# Laravel environment and credentials
# ---------------------------------------------------------

/.env
/.env.*
!/.env.example

.env
.env.local
.env.production
.env.staging
.env.testing
.env.backup
.env.old

# Server-specific configuration that must not be copied
/.user.ini
/php.ini
/public/.user.ini
/public/php.ini



# ---------------------------------------------------------
# PHP / Composer dependencies
# ---------------------------------------------------------

/vendor/
composer.phar

# Composer authentication may contain private tokens
/auth.json
/.composer/
composer-auth.json


# ---------------------------------------------------------
# Node / npm dependencies and temporary Vite files
# ---------------------------------------------------------

/node_modules/
/public/hot
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ---------------------------------------------------------
# Vite production output
#
# Recommended: build locally and upload public/build
# separately to hosting.
# ---------------------------------------------------------

/public/build/


# ---------------------------------------------------------
# Laravel runtime files
# ---------------------------------------------------------

/bootstrap/cache/*.php

/storage/logs/*
!/storage/logs/.gitignore

/storage/framework/cache/*
!/storage/framework/cache/.gitignore

/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore

/storage/framework/views/*
!/storage/framework/views/.gitignore

/storage/framework/testing/*
!/storage/framework/testing/.gitignore

/storage/*.key


# ---------------------------------------------------------
# Uploaded files and public storage symlink
#
# Admin-uploaded photos may contain production content and
# should be backed up separately, not stored in GitHub.
# ---------------------------------------------------------

/storage/app/public/*
!/storage/app/public/.gitignore

/public/storage


# ---------------------------------------------------------
# Databases and database exports
# ---------------------------------------------------------

*.sql
*.sql.gz
*.dump
*.dump.gz
*.sqlite
*.sqlite3
*.db
*.bak

/database/*.sqlite
/database/backups/
/database/exports/


# ---------------------------------------------------------
# Customer, booking, and private exports
# ---------------------------------------------------------

/private/
/secrets/
/exports/
/customer-data/
/booking-exports/

# Put CSV/XLSX containing customer data in one of the
# ignored folders above. Do not leave them in the root.


# ---------------------------------------------------------
# Project and hosting backups
# ---------------------------------------------------------

/backups/
/backup/
/hosting-backup/
/deployment-backup/

*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# Common copied hosting folders
/storage-old/
/public/storage-old/
/public/public - Copy/


